{
	// src/shared is usable on the server and on the client: checked alone, without the
	// types of Node ("types": []) nor the DOM ("lib" without "DOM"). An import of node:*
	// or a use of process, Buffer, document... fails here
	"compilerOptions": {
		"target": "ES2022",
		"lib": ["ES2024"],
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"strict": true,
		"strictNullChecks": false,
		"noEmit": true,
		"skipLibCheck": true,
		"types": []
	},
	"include": ["src/shared"]
}
