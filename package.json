{
	"name": "@r-libre/z4js",
	"version": "1.0.6",
	"description": "Backend framework: TypeScript sources, Postgres or SQLite, secure by design.",
	"license": "MIT",
	"author": "Etienne Cochard",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/rlibre/z4js.git"
	},
	"homepage": "https://github.com/rlibre/z4js",
	"type": "module",
	"sideEffects": false,
	"exports": {
		".": "./src/index.ts",
		"./shape": "./src/shared/shape.ts",
		"./iconv-lite": "./src/iconv-lite.ts",
		"./mime-db": "./src/mime-db.json"
	},
	"bin": {
		"z4js": "bin/z4js.js"
	},
	"files": [
		"src",
		"bin",
		"aiguide.md",
		"aicontext.md"
	],
	"scripts": {
		"build": "esbuild cli/z4js.ts --bundle --platform=node --format=esm --target=node22 --charset=utf8 --keep-names --external:typescript --external:esbuild --outdir=bin --log-level=warning",
		"prepack": "npm run build",
		"build-publish": "deno run --allow-all ./publish.ts",
		"typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.shared.json --noEmit",
		"mime-db": "node scripts/mime-db.ts"
	},
	"dependencies": {
		"@fastify/busboy": "^3.2.2",
		"esbuild": "^0.28.0",
		"express": "^5.1.0",
		"postgres": "^3.4.0",
		"ws": "^8.22.0"
	},
	"devDependencies": {
		"@types/express": "^5.0.0",
		"@types/node": "^22.0.0",
		"@types/ws": "^8.18.2",
		"typescript": "^5.6.0"
	},
	"peerDependencies": {
		"typescript": ">=5.0"
	},
	"peerDependenciesMeta": {
		"typescript": {
			"optional": true
		}
	}
}
